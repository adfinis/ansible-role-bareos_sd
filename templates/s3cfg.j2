{{ ansible_managed | comment }}
[default]
access_key = {{ item.access_key }}
secret_key = {{ item.secret_key }}
host_base = {{ item.host_base }}{{ ':' ~ item.port if item.port is defined else '' }}
host_bucket = {{ item.host_bucket }}{{ ':' ~ item.port if item.port is defined else '' }}
use_https = {{ item.https_enabled | default(false) | ternary('True', 'False') }}
